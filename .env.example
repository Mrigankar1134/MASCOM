# ── Database ────────────────────────────────────────────────────────────────
# Point this at the SAME MongoDB the current MASCOM server uses, the rebuild
# reads and writes the existing collections (users, products, orders,
# paymentrecipients, batches, coupons) without any migration.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/mascom"

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
# How long a signed-in session lasts.
SESSION_TTL_DAYS="30"

# ── Access rules ────────────────────────────────────────────────────────────
# Only these email domains may register (comma separated). Empty = allow all.
ALLOWED_EMAIL_DOMAINS="iimamritsar.ac.in"
# Emails that are granted the admin role on first sign-up (comma separated).
BOOTSTRAP_ADMIN_EMAILS=""

# ── Uploads ─────────────────────────────────────────────────────────────────
# Directory payment screenshots, product images and QR codes are written to.
# Use a mounted persistent disk in production.
UPLOAD_DIR="./public/uploads"
# Public base path those files are served from.
UPLOAD_PUBLIC_PATH="/uploads"

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
